<% content_for :title, "Book a ride - Medride" %>

<div class="mx-auto max-w-xl">
  <h1 class="text-2xl font-semibold tracking-tight mb-6">Book a ride</h1>

  <%= form_with model: @ride, class: "space-y-6" do |f| %>
    <% if @ride.errors.any? %>
      <div class="rounded-lg border border-status-cancelled/20 bg-status-cancelled-soft px-4 py-3 text-sm text-status-cancelled">
        <p class="font-medium mb-1"><%= pluralize(@ride.errors.count, "error") %> prevented this ride from saving:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% @ride.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="<%= card_classes("space-y-4") %>">
      <div>
        <%= f.label :patient_id, class: "block text-sm font-medium mb-1.5" %>
        <%= f.collection_select :patient_id, Patient.order(:last_name), :id, :name, {}, class: input_classes %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :scheduled_at, class: "block text-sm font-medium mb-1.5" %>
          <%= f.datetime_field :scheduled_at, class: input_classes %>
        </div>

        <div>
          <%= f.label :level_of_service, class: "block text-sm font-medium mb-1.5" %>
          <%= f.select :level_of_service, Ride.level_of_services.keys.map { |k| [ k.humanize, k ] }, {}, class: input_classes %>
        </div>
      </div>
    </div>

    <fieldset class="<%= card_classes %> relative" data-controller="address-autocomplete">
      <legend class="text-sm font-semibold text-faint uppercase tracking-wide px-1 mb-2">Pickup</legend>
      <div data-address-autocomplete-target="mount"></div>
      <%= f.hidden_field :pickup_address_line1, data: { address_autocomplete_target: "line1" } %>
      <%= f.hidden_field :pickup_city, data: { address_autocomplete_target: "city" } %>
      <%= f.hidden_field :pickup_state, data: { address_autocomplete_target: "state" } %>
      <%= f.hidden_field :pickup_zip, data: { address_autocomplete_target: "zip" } %>
      <%= f.hidden_field :pickup_lat, data: { address_autocomplete_target: "lat" } %>
      <%= f.hidden_field :pickup_lng, data: { address_autocomplete_target: "lng" } %>
    </fieldset>

    <fieldset class="<%= card_classes %> relative" data-controller="address-autocomplete">
      <legend class="text-sm font-semibold text-faint uppercase tracking-wide px-1 mb-2">Dropoff</legend>
      <div data-address-autocomplete-target="mount"></div>
      <%= f.hidden_field :dropoff_address_line1, data: { address_autocomplete_target: "line1" } %>
      <%= f.hidden_field :dropoff_city, data: { address_autocomplete_target: "city" } %>
      <%= f.hidden_field :dropoff_state, data: { address_autocomplete_target: "state" } %>
      <%= f.hidden_field :dropoff_zip, data: { address_autocomplete_target: "zip" } %>
      <%= f.hidden_field :dropoff_lat, data: { address_autocomplete_target: "lat" } %>
      <%= f.hidden_field :dropoff_lng, data: { address_autocomplete_target: "lng" } %>
    </fieldset>

    <%= f.submit "Book ride", class: "#{btn_primary} w-full py-2.5" %>
  <% end %>
</div>
