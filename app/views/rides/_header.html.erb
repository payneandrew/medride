<div id="<%= dom_id(ride, :header) %>" class="<%= card_classes %> mb-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold text-faint uppercase tracking-wide mb-1">Ride #<%= ride.id %></p>
      <h1 class="text-2xl font-semibold tracking-tight"><%= ride.patient.name %></h1>
      <p class="text-sm text-muted mt-1">
        <%= level_of_service_label(ride.level_of_service) %> &middot; <%= ride.scheduled_at.strftime("%b %-d, %Y at %-I:%M%p") %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= ride_status_badge(ride.status) %>
      <% if ride.needs_authorization? %><%= needs_authorization_badge %><% end %>
    </div>
  </div>

  <% if ride.active_claim %>
    <div class="mt-4 flex items-center gap-2 rounded-lg bg-paper px-3 py-2 text-sm">
      <span class="flex size-6 items-center justify-center rounded-full bg-accent-soft text-accent text-xs font-semibold shrink-0">
        <%= ride.active_claim.transport_provider.name.first.upcase %>
      </span>
      <span>Claimed by <span class="font-medium"><%= ride.active_claim.transport_provider.name %></span></span>
      <% if ride.active_claim.external_ride_id %>
        <span class="text-faint font-mono text-xs">#<%= ride.active_claim.external_ride_id %></span>
      <% end %>
    </div>
  <% end %>

  <% if (current_coordinator && ride.can_claim? && UberHealth::Client::SUPPORTED_LEVELS_OF_SERVICE.include?(ride.level_of_service)) ||
        (current_transport_provider && ride.active_claim&.transport_provider == current_transport_provider && (ride.can_start? || ride.can_complete? || ride.can_release?)) %>
    <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
      <% if current_coordinator && ride.can_claim? && UberHealth::Client::SUPPORTED_LEVELS_OF_SERVICE.include?(ride.level_of_service) %>
        <%= button_to "Dispatch via Uber Health", ride_uber_health_dispatch_path(ride), method: :post, class: btn_secondary %>
      <% end %>

      <% if current_transport_provider && ride.active_claim&.transport_provider == current_transport_provider %>
        <% if ride.can_start? %>
          <%= button_to "Start ride", start_ride_path(ride), method: :patch, class: btn_primary %>
        <% end %>
        <% if ride.can_complete? %>
          <%= button_to "Complete ride", complete_ride_path(ride), method: :patch, class: btn_primary %>
        <% end %>
        <% if ride.can_release? %>
          <%= button_to "Release", ride_claim_path(ride), method: :delete, class: btn_subtle_danger %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
