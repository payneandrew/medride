<% content_for :title, "Ride ##{@ride.id} - Medride" %>

<%= render "header", ride: @ride %>

<section class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
  <div class="<%= card_classes %>">
    <h2 class="flex items-center gap-1.5 text-xs font-semibold text-faint uppercase tracking-wide mb-2">
      <span class="size-1.5 rounded-full bg-status-completed"></span> Pickup
    </h2>
    <p class="text-sm"><%= @ride.pickup_address_line1 %></p>
    <p class="text-sm text-muted"><%= @ride.pickup_city %>, <%= @ride.pickup_state %> <%= @ride.pickup_zip %></p>
  </div>
  <div class="<%= card_classes %>">
    <h2 class="flex items-center gap-1.5 text-xs font-semibold text-faint uppercase tracking-wide mb-2">
      <span class="size-1.5 rounded-full bg-status-cancelled"></span> Dropoff
    </h2>
    <p class="text-sm"><%= @ride.dropoff_address_line1 %></p>
    <p class="text-sm text-muted"><%= @ride.dropoff_city %>, <%= @ride.dropoff_state %> <%= @ride.dropoff_zip %></p>
  </div>
</section>

<% if @ranked_providers.present? %>
  <section class="mb-6">
    <h2 class="text-sm font-semibold text-faint uppercase tracking-wide mb-1">Eligible providers</h2>
    <p class="text-sm text-muted mb-3">Ranked by reliability, dispatch distance, and estimated price.</p>
    <div class="<%= card_classes("p-0 overflow-hidden") %>">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="text-left text-faint border-b border-line">
            <th class="py-2.5 px-5 font-medium">Provider</th>
            <th class="py-2.5 px-4 font-medium">Reliability</th>
            <th class="py-2.5 px-4 font-medium">Distance</th>
            <th class="py-2.5 px-4 font-medium">Est. price</th>
            <th class="py-2.5 px-5 font-medium">Match score</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @ranked_providers.each do |result| %>
            <tr class="hover:bg-paper transition-colors">
              <td class="py-3 px-5 font-medium"><%= result.transport_provider.name %></td>
              <td class="py-3 px-4 text-muted tabular-nums"><%= number_to_percentage(result.reliability_score * 100, precision: 0) %></td>
              <td class="py-3 px-4 text-muted tabular-nums"><%= result.distance_miles ? "#{result.distance_miles.round(1)} mi" : "unknown" %></td>
              <td class="py-3 px-4 text-muted tabular-nums"><%= number_to_currency(result.estimated_price_cents / 100.0) %></td>
              <td class="py-3 px-5">
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-16 rounded-full bg-paper overflow-hidden">
                    <div class="h-full rounded-full bg-accent" style="width: <%= (result.score * 100).round %>%"></div>
                  </div>
                  <span class="tabular-nums text-xs text-muted"><%= result.score.round(2) %></span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% elsif @ranked_providers&.empty? %>
  <section class="mb-6">
    <h2 class="text-sm font-semibold text-faint uppercase tracking-wide mb-1">Eligible providers</h2>
    <div class="<%= card_classes("text-sm text-muted") %>">No providers currently cover this pickup zip and level of service.</div>
  </section>
<% end %>

<%= render "audit_trail", ride: @ride %>
