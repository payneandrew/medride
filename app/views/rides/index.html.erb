<% content_for :title, "Rides - Medride" %>

<% if current_transport_provider %>
  <h1 class="text-2xl font-semibold tracking-tight mb-8">Rides for <%= current_transport_provider.name %></h1>

  <section class="mb-10">
    <h2 class="text-sm font-semibold text-faint uppercase tracking-wide mb-3">My active rides</h2>
    <div id="my_active_rides" class="<%= card_classes("divide-y divide-line p-0") %> empty:p-0">
      <% if @my_rides.empty? %>
        <p class="px-5 py-6 text-sm text-muted text-center">Nothing claimed right now.</p>
      <% else %>
        <%= render partial: "rides/active_ride_row", collection: @my_rides, as: :ride %>
      <% end %>
    </div>
  </section>

  <section>
    <h2 class="text-sm font-semibold text-faint uppercase tracking-wide mb-1">Claimable rides</h2>
    <p class="text-sm text-muted mb-3">Requested rides whose pickup zip and level of service match your coverage.</p>
    <div id="claimable_rides" class="<%= card_classes("divide-y divide-line p-0") %>">
      <% if @claimable_rides.empty? %>
        <p class="px-5 py-6 text-sm text-muted text-center">Nothing to claim right now.</p>
      <% else %>
        <% @claimable_rides.each do |ride| %>
          <%= render "rides/claimable_row", ride: ride, ranking: @rankings_by_ride_id[ride] %>
        <% end %>
      <% end %>
    </div>
  </section>

<% else %>
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-semibold tracking-tight">Rides</h1>
    <% if current_coordinator %>
      <%= link_to "Book a ride", new_ehr_import_path, class: btn_primary %>
    <% end %>
  </div>

  <% if @rides.empty? %>
    <div class="<%= card_classes("text-center py-10") %>">
      <p class="text-sm text-muted">No rides booked yet.</p>
    </div>
  <% else %>
    <div class="<%= card_classes("p-0 overflow-hidden") %>">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="text-left text-faint border-b border-line">
            <th class="py-2.5 px-5 font-medium">Patient</th>
            <th class="py-2.5 px-4 font-medium">Scheduled</th>
            <th class="py-2.5 px-4 font-medium">Level of service</th>
            <th class="py-2.5 px-4 font-medium">Status</th>
            <th class="py-2.5 px-5"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @rides.each do |ride| %>
            <tr class="hover:bg-paper transition-colors">
              <td class="py-3 px-5 font-medium"><%= ride.patient.name %></td>
              <td class="py-3 px-4 text-muted tabular-nums"><%= ride.scheduled_at.strftime("%b %-d, %Y %-I:%M%p") %></td>
              <td class="py-3 px-4 text-muted"><%= level_of_service_label(ride.level_of_service) %></td>
              <td class="py-3 px-4"><%= ride_status_badge(ride.status) %></td>
              <td class="py-3 px-5 text-right"><%= link_to "View", ride_path(ride), class: "text-accent font-medium hover:underline underline-offset-2" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
