<% content_for :title, "Book a ride - Medride" %>

<h1 class="text-2xl font-semibold tracking-tight mb-8">Book a ride</h1>

<section class="mb-10">
  <h2 class="text-sm font-semibold text-faint uppercase tracking-wide mb-3">Existing patients</h2>
  <% if @patients.empty? %>
    <div class="<%= card_classes("text-sm text-muted") %>">No patients yet — import one from the EHR below.</div>
  <% else %>
    <div class="<%= card_classes("divide-y divide-line p-0") %>">
      <% @patients.each do |patient| %>
        <div class="flex items-center justify-between gap-4 px-5 py-3.5">
          <div class="flex items-center gap-3 min-w-0">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent font-semibold text-sm">
              <%= patient.first_name.first.upcase %>
            </span>
            <div class="min-w-0">
              <p class="font-medium truncate"><%= patient.name %></p>
              <p class="text-sm text-faint truncate"><%= patient.home_city %>, <%= patient.home_state %> &middot; <%= patient.phone %></p>
            </div>
          </div>
          <%= link_to "Book a ride", new_ride_path(patient_id: patient.id), class: "#{btn_primary} shrink-0" %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section>
  <h2 class="text-sm font-semibold text-faint uppercase tracking-wide mb-3">Import a new patient from the EHR</h2>
  <div class="<%= card_classes %>">
    <p class="text-sm text-muted mb-4">
      Search the FHIR test server by last name, then pick the right patient from
      the results — pulls their demographics and any upcoming appointment, and
      starts a new ride booking pre-filled with it.
    </p>

    <%= form_with url: search_ehr_import_path, method: :get, class: "flex gap-2" do |f| %>
      <%= f.text_field :family_name, class: input_classes, placeholder: "Last name, e.g. Wayne" %>
      <%= f.submit "Search", class: "#{btn_primary} whitespace-nowrap" %>
    <% end %>
  </div>
</section>
