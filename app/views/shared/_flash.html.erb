<div id="flash" class="space-y-2">
  <% if notice %>
    <p data-controller="auto-dismiss" class="flex items-start gap-2 rounded-lg border border-status-completed/20 bg-status-completed-soft px-4 py-3 text-sm text-status-completed">
      <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
      <span><%= notice %></span>
    </p>
  <% end %>
  <% if alert %>
    <p data-controller="auto-dismiss" class="flex items-start gap-2 rounded-lg border border-status-cancelled/20 bg-status-cancelled-soft px-4 py-3 text-sm text-status-cancelled">
      <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 6a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 6zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>
      <span><%= alert %></span>
    </p>
  <% end %>
</div>
